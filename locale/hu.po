msgctxt "model:ir.message,text:msg_tracking_ref_cancel"
msgid ""
"\"%(shipment)s\" has a carrier tracking reference. Please, contact the "
"carrier and cancel the shipment."
msgstr ""
"A(z) „%(shipment)s” szállítmánynak van fuvarozói nyomkövetési azonosítója. "
"Lépjen kapcsolatba a fuvarozóval, és mondja le a szállítmányt."
